/*********************************************************************************************************************
* 文件名称：menu.h
* 功能说明：单页参数菜单接口
* 参数内容：P、D、电机PWM
* 保存说明：参数只保存在RAM中，掉电后恢复默认值
********************************************************************************************************************/

#ifndef CODE_MENU_H_
#define CODE_MENU_H_

#include "zf_common_headfile.h"

// Err是CPU1计算出的摄像头中线误差
extern volatile float Err;

// 初始化菜单、按键和屏幕
void Menu_Init(void);

// 扫描按键并更新菜单
void Menu_Update(void);

// 返回1表示当前显示菜单，返回0表示显示图像
uint8 Menu_IsMenuPage(void);

// 图像页面底部的参数显示
void Menu_DrawImageOverlay(void);

// 返回当前菜单中的P参数
float Menu_GetKp(void);

// 返回当前菜单中的D参数
float Menu_GetKd(void);

// 返回菜单中的电机基础PWM
int Menu_GetMotorPwm(void);

#endif /* CODE_MENU_H_ */
