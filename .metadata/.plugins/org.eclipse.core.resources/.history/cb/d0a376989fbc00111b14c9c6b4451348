/*********************************************************************************************************************
* 函数名称：Menu_Draw
* 功能说明：根据menu_page绘制菜单
* 参数说明：无
* 返回说明：无
********************************************************************************************************************/
static void Menu_Draw(void)
{
    // 一级菜单
    if(menu_page == MENU_PAGE_MAIN)
        Menu_DrawMain();

    // PD菜单
    else if(menu_page == MENU_PAGE_PD)
        Menu_DrawPd();

    // 电机PWM菜单
    else if(menu_page == MENU_PAGE_MOTOR)
        Menu_DrawMotor();
}

/*********************************************************************************************************************
* 函数名称：Menu_Init
* 功能说明：初始化菜单
* 参数说明：无
* 返回说明：无
********************************************************************************************************************/
void Menu_Init(void)
{
    // 初始化按键，10表示扫描周期约10ms
    key_init(10);

    // 清除按键状态
    key_clear_all_state();

    // 默认显示图像页面
    menu_page = MENU_PAGE_IMAGE;
    menu_dirty = 1;
    menu_main_item = MENU_MAIN_PD;
    menu_pd_item = MENU_PD_P;
    menu_pd_reset = 1;

    // 设置默认字体和颜色
    tft180_set_font(TFT180_8X16_FONT);
    tft180_set_color(RGB565_WHITE, RGB565_BLACK);
}

/*********************************************************************************************************************
* 函数名称：Menu_Update
* 功能说明：扫描按键并处理菜单
* 参数说明：无
* 返回说明：无
********************************************************************************************************************/
void Menu_Update(void)
{
    // 扫描按键
    key_scanner();

    // 图像页面：S1进入菜单
    if(menu_page == MENU_PAGE_IMAGE)
    {
        if(Menu_KeyEvent(KEY_1))
        {
            menu_page = MENU_PAGE_MAIN;
            menu_dirty = 1;
        }
    }
    // 一级菜单
    else if(menu_page == MENU_PAGE_MAIN)
    {
        // S2向上
        if(Menu_KeyEvent(KEY_2))
        {
            if(menu_main_item == 0)
                menu_main_item = MENU_MAIN_COUNT - 1;
            else
                menu_main_item--;
            menu_dirty = 1;
        }

        // S3向下
        if(Menu_KeyEvent(KEY_3))
        {
            menu_main_item++;
            if(menu_main_item >= MENU_MAIN_COUNT)
                menu_main_item = 0;
            menu_dirty = 1;
        }

        // S1进入
        if(Menu_KeyEvent(KEY_1))
        {
            if(menu_main_item == MENU_MAIN_PD)
                menu_page = MENU_PAGE_PD;
            else if(menu_main_item == MENU_MAIN_MOTOR)
                menu_page = MENU_PAGE_MOTOR;
            else
            {
                menu_page = MENU_PAGE_IMAGE;
                menu_pd_reset = 1;
            }
            menu_dirty = 1;
        }

        // S4返回图像
        if(Menu_KeyEvent(KEY_4))
        {
            menu_page = MENU_PAGE_IMAGE;
            menu_pd_reset = 1;
            menu_dirty = 1;
        }
    }
    // PD页面
    else if(menu_page == MENU_PAGE_PD)
    {
        // S1切换P和D
        if(Menu_KeyEvent(KEY_1))
        {
            menu_pd_item = (menu_pd_item == MENU_PD_P) ?
                           MENU_PD_D : MENU_PD_P;
            menu_dirty = 1;
        }

        // S2减小
        if(Menu_KeyEvent(KEY_2))
            Menu_AdjustPd(-1);

        // S3增大
        if(Menu_KeyEvent(KEY_3))
            Menu_AdjustPd(1);

        // S4返回
        if(Menu_KeyEvent(KEY_4))
        {
            menu_page = MENU_PAGE_MAIN;
            menu_dirty = 1;
        }
    }
    // 电机PWM页面
    else if(menu_page == MENU_PAGE_MOTOR)
    {
        // S2减小
        if(Menu_KeyEvent(KEY_2))
            Menu_AdjustMotor(-1);

        // S3增大
        if(Menu_KeyEvent(KEY_3))
            Menu_AdjustMotor(1);

        // S1或S4返回
        if(Menu_KeyEvent(KEY_1) || Menu_KeyEvent(KEY_4))
        {
            menu_page = MENU_PAGE_MAIN;
            menu_dirty = 1;
        }
    }

    // 菜单有变化时重绘
    if((menu_page != MENU_PAGE_IMAGE) && menu_dirty)
    {
        menu_dirty = 0;
        Menu_Draw();
    }

    // 菜单页面按约10ms扫描按键
    if(menu_page != MENU_PAGE_IMAGE)
        system_delay_ms(10);
}

/*********************************************************************************************************************
* 函数名称：Menu_IsMenuPage
* 功能说明：判断当前是否在菜单页面
* 参数说明：无
* 返回说明：1表示菜单页面，0表示图像页面
********************************************************************************************************************/
uint8 Menu_IsMenuPage(void)
{
    return menu_page != MENU_PAGE_IMAGE;
}

