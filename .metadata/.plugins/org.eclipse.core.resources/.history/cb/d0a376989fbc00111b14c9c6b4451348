    tft180_show_string(0, 32, "P:");
    tft180_show_float(32, 32, menu_kp, 4, 2);

    // D参数
    tft180_set_color((menu_pd_item == MENU_PD_D) ? RGB565_YELLOW : RGB565_WHITE,
                     RGB565_BLACK);
    tft180_show_string(0, 60, "D:");
    tft180_show_float(32, 60, menu_kd, 4, 2);

