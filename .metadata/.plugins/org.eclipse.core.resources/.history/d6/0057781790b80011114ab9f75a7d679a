/*-------------------------------------------------------------------------------------------------------------------
  @brief     普通大津求阈值
  @param     image       图像数组
             width       列 ，宽度
             height      行，长度
  @return    threshold   返回int类型的的阈值
  Sample     threshold=my_adapt_threshold(mt9v03x_image[0],MT9V03X_W, MT9V03X_H);//普通大津
  @note      据说没有山威大津快，我感觉两个区别不大
-------------------------------------------------------------------------------------------------------------------*/

int My_Adapt_Threshold(uint8*image,uint16 width, uint16 height)   //大津算法，注意计算阈值的一定要是原图像
 {
     #define GrayScale 256      //宏定义灰度
     int pixelCount[GrayScale];     //定义像素次数
     float pixelPro[GrayScale];     //定义像素频率
     int i, j;
     int pixelSum = width * height/4;       //定义像素个数  隔一行，隔一列
     int  threshold = 0;                //定义阈值
     uint8* data = image;  //指向像素数据的指针
     for (i = 0; i < GrayScale; i++)        //像素次数、频率初始化
     {
         pixelCount[i] = 0;
         pixelPro[i] = 0;
     }
     uint32 gray_sum=0;     //定义灰度总和
     for (i = 0; i < height; i+=2)//统计灰度级中每个像素在整幅图像中的个数
     {
         for (j = 0; j <width; j+=2)
         {
             pixelCount[(int)data[i * width + j]]++;  //将当前的点的像素值作为计数数组的下标，强转(int)防越界
             gray_sum+=(int)data[i * width + j];       //灰度值总和
         }
     }
     for (i = 0; i < GrayScale; i++) //计算每个像素值的点在整幅图像中的比例,相当于画直方图📊
     {
         pixelPro[i] = (float)pixelCount[i] / pixelSum;
     }
     float w0, w1, u0tmp, u1tmp, u0, u1, u, deltaTmp, deltaMax = 0;
     w0 = w1 = u0tmp = u1tmp = u0 = u1 = u = deltaTmp = 0;
                     /*** w0          黑比例              当前分界线以下像素占整张图的比例
                          w1          白比例              当前分界线以上像素占整张图的比例
                          u0tmp       黑亮度贡献          黑所有亮度的比例加权和，还没有除以 w0
                          u1tmp       白亮度贡献          白所有亮度的比例加权和，还没有除以 w1
                          u0          黑平均亮度          黑像素的平均灰度值
                          u1          白平均亮度          白像素的平均灰度值
                          u           全图平均亮度        整张图片所有像素的平均灰度值
                          deltaTmp    当前分界线的得分    当前这个阈值把黑白分得有多开
                          deltaMax    目前最高得分        目前找到的最好的 deltaTmp                ***/
     for (j = 0; j < GrayScale; j++)//遍历灰度级[0,255]
     {
         w0 += pixelPro[j];  //背景部分每个灰度值的像素点所占比例之和   即背景部分的比例
         u0tmp += j * pixelPro[j];  //背景部分 每个灰度值的点的比例 *灰度值
         w1=1-w0;
         u1tmp=(float)gray_sum/pixelSum-u0tmp;
         u0 = u0tmp / w0;              //背景平均灰度
         u1 = u1tmp / w1;              //前景平均灰度
         u = u0tmp + u1tmp;            //全局平均灰度
         deltaTmp = w0 * pow((u0 - u), 2) + w1 * pow((u1 - u), 2);//平方
         if (deltaTmp > deltaMax)
         {
             deltaMax = deltaTmp;//最大类间方差法
             threshold = j;
         }
         if (deltaTmp < deltaMax)
         {
             break;
         }
     }
     if(threshold>255)
         threshold=255;
     if(threshold<0)
         threshold=0;
   return threshold;
 }

uint8 image_two_value[MT9V03X_H][MT9V03X_W];//二值化后的原数组
void Image_Binarization(int threshold)//图像二值化
{
    uint16 i,j;
    for(i=0;i<MT9V03X_H;i++)
    {
        for(j=0;j<MT9V03X_W;j++)//灰度图的数据只做判断，不进行更改，二值化图像放在了新数组中
        {
            if(mt9v03x_image[i][j]>threshold)
                image_two_value[i][j]=IMG_WHITE;//白
            else
                image_two_value[i][j]=IMG_BLACK;//黑
        }
    }
}

/******************************************** 最长白线获取 ********************************************/
int Longest_White_Column_Left[2] = {0};
int Longest_White_Column_Right[2] = {0};
volatile int Search_Stop_Line = 0;
int Right_Lost_Flag[MT9V03X_H] = {0};
int Left_Lost_Flag[MT9V03X_H] = {0};
volatile int Left_Line[MT9V03X_H] = {0};
volatile int Right_Line[MT9V03X_H] = {0};
volatile int Left_Lost_Time = 0,Right_Lost_Time = 0,Both_Lost_Time = 0;
int left_border = 0, right_border = 0;//临时存储赛道位置
int Road_Wide[MT9V03X_H]={0};
int Center_Line[MT9V03X_H]={0};
int Boundry_Start_Left=0,Boundry_Start_Right=0;
void XunXian(void)
{
    volatile int White_Column[MT9V03X_W] = {0};//每列白列长度
    uint8 start_column=20;      //起始列
    uint8 end_column=168;       //终止列
    int i,j;
    //复位
    Longest_White_Column_Left[0] = 0;
    Longest_White_Column_Left[1] = 0;
    Longest_White_Column_Right[0] = 0;
    Longest_White_Column_Right[1] = 0;

    Search_Stop_Line = 0;

    Left_Lost_Time = 0;
    Right_Lost_Time = 0;
    Both_Lost_Time = 0;

    Boundry_Start_Left = 0;
    Boundry_Start_Right = 0;

    for (i = 0; i < MT9V03X_H; i++)
    {
        Left_Lost_Flag[i] = 1;
        Right_Lost_Flag[i] = 1;

        Left_Line[i] = 0;
        Right_Line[i] = MT9V03X_W - 1;

        Road_Wide[i] = 0;
        Center_Line[i] = (MT9V03X_W - 1) / 2;
    }

    for (j = 0; j < MT9V03X_W; j++)
    {
        White_Column[j] = 0;
    }
    //从左到右，从下往上，遍历全图记录范围内的每一列白点数量
    for (j =start_column; j<=end_column; j++)
    {
        for (i = MT9V03X_H - 1; i >= 0; i--)
        {
            if(image_two_value[i][j] == IMG_BLACK)
                break;
            else
                White_Column[j]++;
        }
    }


    for(i=start_column;i<=end_column;i++)//从左到右找左边最长白列
    {
        if (Longest_White_Column_Left[0] < White_Column[i])//找最长的那一列
        {
            Longest_White_Column_Left[0] = White_Column[i];//【0】是白列长度
            Longest_White_Column_Left[1] = i;              //【1】是下标，第j列
        }
    }
        //从右到左找右左边最长白列
    for(i=end_column;i>=start_column;i--)//从右往左，注意条件，找到左边最长白列位置就可以停了
    {
        if (Longest_White_Column_Right[0] < White_Column[i])//找最长的那一列
        {
            Longest_White_Column_Right[0] = White_Column[i];//【0】是白列长度
            Longest_White_Column_Right[1] = i;              //【1】是下标，第j列
        }
    }
    Search_Stop_Line = Longest_White_Column_Left[0];//搜索截止行选取左或者右区别不大，他们两个理论上是一样的


/*********************************************************由最长白线推出左右边线**************************************************/


     for (i = MT9V03X_H - 1; i >=MT9V03X_H-Search_Stop_Line; i--)//常规巡线
     {//从最下面一行，访问到我的有效视野行
         left_border = 0;
         right_border = MT9V03X_W - 1;
         for (j = Longest_White_Column_Right[1]; j <= MT9V03X_W - 1 - 2; j++)
         {
             if (image_two_value[i][j] ==IMG_WHITE && image_two_value[i][j + 1] == IMG_BLACK && image_two_value[i][j + 2] == IMG_BLACK)//白黑黑，找到右边界
             {
                 right_border = j;
                 Right_Lost_Flag[i] = 0; //右丢线数组，丢线置1，不丢线置0
                 break;
             }
             else if(j>=MT9V03X_W-1-2)//没找到右边界，把屏幕最右赋值给右边界
             {
                 right_border = j;
                 Right_Lost_Flag[i] = 1; //右丢线数组，丢线置1，不丢线置0
                 break;
             }
         }
         for (j = Longest_White_Column_Left[1]; j >= 0 + 2; j--)//往左边扫描
         {//从最下面一行，访问到我的有效视野行
             if (image_two_value[i][j] ==IMG_WHITE && image_two_value[i][j - 1] == IMG_BLACK && image_two_value[i][j - 2] == IMG_BLACK)//黑黑白认为到达左边界
             {
                 left_border = j;
                 Left_Lost_Flag[i] = 0; //左丢线数组，丢线置1，不丢线置0
                 break;
             }
             else if(j<=0+2)
             {
                 left_border = j;//找到头都没找到边，就把屏幕最左右当做边界
                 Left_Lost_Flag[i] = 1; //左丢线数组，丢线置1，不丢线置0
                 break;
             }
         }
         Left_Line [i] = left_border;       //左边线线数组
         Right_Line[i] = right_border;      //右边线线数组
     }
     for (i = MT9V03X_H - 1; i >= 0; i--)//赛道数据初步分析
         {
             if (Left_Lost_Flag[i]  == 1)   //左边丢线数
                 Left_Lost_Time++;
             if (Right_Lost_Flag[i] == 1)   //右边丢线数
                 Right_Lost_Time++;
             if (Left_Lost_Flag[i] == 1 && Right_Lost_Flag[i] == 1)  //双边丢线数
                 Both_Lost_Time++;
             if (Boundry_Start_Left ==  0 && Left_Lost_Flag[i]  != 1)//记录第一个非丢线点，边界起始点
                 Boundry_Start_Left = i;
             if (Boundry_Start_Right == 0 && Right_Lost_Flag[i] != 1)
                 Boundry_Start_Right = i;
             Road_Wide[i]=Right_Line[i]-Left_Line[i];
             Center_Line[i] = (Left_Line[i] + Right_Line[i]) / 2;
         }

     //debug使用，屏幕显示相关参数
  //    tft180_show_char(0,0, Longest_White_Column_Right[0]);       //【0】是白列长度
  //    tft180_show_char(0,1, Longest_White_Column_Right[1]);       //【1】是下标，第j列)
  //    tft180_show_char(0,2, Longest_White_Column_Left[0]);        //【0】是白列长度
  //    tft180_show_char(0,3, Longest_White_Column_Left[1]);        //【1】是下标，第j列)

}

/*-------------------------------------------------------------------------------------------------------------------
  @brief     直道检测
  @param     null
  @return    null
  Sample     Straight_Detect()；
  @note      利用最长白列，边界起始点，中线起始点，
-------------------------------------------------------------------------------------------------------------------*/
extern volatile uint8 Straight_Flag=0;
extern volatile float Err=0;
void Straight_Detect(void)
{
    Straight_Flag=0;
    Err=Err_Sum();
    if(Search_Stop_Line>=110)//截止行很大，很远
    {
        if(Boundry_Start_Left>=105&&Boundry_Start_Right>=105)//起始点靠下
        {
            if(-5<=Err&&Err<=5)//误差很小
            {
                Straight_Flag=1;//认为是直道
            }
        }
    }
}

/*-------------------------------------------------------------------------------------------------------------------
  @brief  查找十字下方两个拐点（靠近车头一侧的路口角）
  @param  start 搜索起始行（靠下，数值大），end 搜索终止行（靠上，数值小）
  @return 无，直接修改全局 Left_Down_Find / Right_Down_Find
  @note   特征：拐点下方（近处）边线平稳，拐点上方（远处）边线突变
-------------------------------------------------------------------------------------------------------------------*/
extern int Right_Down_Inflection_Point=0;
extern int Left_Down_Inflection_Point=0;
void Find_Down_Inflection_Point(int start, int end)
{
    int i, t;
    Right_Down_Inflection_Point = 0;
    Left_Down_Inflection_Point = 0;

    // 行号矫正：保证从下往上搜（start > end）
    if(start < end) {
        t = start;
        start = end;
        end = t;
    }

    // 数组越界保护：底部5行数据不稳定，舍弃
    if(start >= MT9V03X_H - 1 - 5)
        start = MT9V03X_H - 1 - 5;
    // 搜索截止行以上的区域不搜索
    if(end <= MT9V03X_H - Search_Stop_Line)
        end = MT9V03X_H - Search_Stop_Line;
    if(end <= 5) end = 5;

    // 从下往上逐行扫描
    for(i = start; i >= end; i--)
    {
        // 左下拐点：下方连续3行平稳，上方向左突变（x骤减）
        if(Left_Down_Inflection_Point == 0 &&
           abs(Left_Line[i] - Left_Line[i+1]) <= 5 &&   // 下方第1行平稳
           abs(Left_Line[i+1] - Left_Line[i+2]) <= 5 && // 下方第2行平稳
           abs(Left_Line[i+2] - Left_Line[i+3]) <= 5 && // 下方第3行平稳
           (Left_Line[i] - Left_Line[i-2]) >= 8 &&      // 上方2行处x突变（变小）
           (Left_Line[i] - Left_Line[i-3]) >= 15 &&     // 上方3行处突变更明显
           (Left_Line[i] - Left_Line[i-4]) >= 15)       // 上方4行处确认突变
        {
            Left_Down_Inflection_Point = i;
        }

        // 右下拐点：下方连续3行平稳，上方向右突变（x骤增）
        if(Right_Down_Inflection_Point == 0 &&
           abs(Right_Line[i] - Right_Line[i+1]) <= 5 &&
           abs(Right_Line[i+1] - Right_Line[i+2]) <= 5 &&
           abs(Right_Line[i+2] - Right_Line[i+3]) <= 5 &&
           (Right_Line[i] - Right_Line[i-2]) <= -8 &&
           (Right_Line[i] - Right_Line[i-3]) <= -15 &&
           (Right_Line[i] - Right_Line[i-4]) <= -15)
        {
            Right_Down_Inflection_Point = i;
        }

        // 两个都找到就提前退出，节省时间
        if(Left_Down_Inflection_Point != 0 && Right_Down_Inflection_Point != 0)
            break;
    }
}
/*-------------------------------------------------------------------------------------------------------------------
  @brief  查找十字上方两个拐点（远离车头一侧的路口角）
  @param  start 搜索起始行（靠下，数值大），end 搜索终止行（靠上，数值小）
  @return 无，修改全局 Left_Up_Inflection_Find / Right_Up_Inflection_Find
  @note   特征：拐点上方（远处）边线平稳，拐点下方（近处）边线突变
-------------------------------------------------------------------------------------------------------------------*/

extern int Left_Up_Inflection_Point = 0;           // 左上拐点所在行号，0=未找到
extern int Right_Up_Inflection_Point = 0;          // 右上拐点所在行号，0=未找到
void Find_Up_Inflection_Point(int start,int end)
{
    int i,t;
    Left_Up_Inflection_Point=0;
    Right_Up_Inflection_Point=0;
    if(start<end)
    {
        t=start;
        start=end;
        end=t;
    }
    if(end<=MT9V03X_H-Search_Stop_Line)
        end=MT9V03X_H-Search_Stop_Line;
    if(end<=5)//及时最长白列非常长，也要舍弃部分点，防止数组越界
        end=5;
    if(start>=MT9V03X_H-1-5)//下面5行数据不稳定，不能作为边界点来判断，舍弃
        start=MT9V03X_H-1-5;
    for(i=start;i>=end;i--)
    {
        if(Left_Up_Inflection_Point==0&&//只找第一个符合条件的点
           abs(Left_Line[i]-Left_Line[i-1])<=5&&
           abs(Left_Line[i-1]-Left_Line[i-2])<=5&&
           abs(Left_Line[i-2]-Left_Line[i-3])<=5&&
              (Left_Line[i]-Left_Line[i+2])>=8&&
              (Left_Line[i]-Left_Line[i+3])>=15&&
              (Left_Line[i]-Left_Line[i+4])>=15)
        {
            Left_Up_Inflection_Point=i;//获取行数即可
        }
        if(Right_Up_Inflection_Point==0&&//只找第一个符合条件的点
           abs(Right_Line[i]-Right_Line[i-1])<=5&&//下面两行位置差不多
           abs(Right_Line[i-1]-Right_Line[i-2])<=5&&
           abs(Right_Line[i-2]-Right_Line[i-3])<=5&&
              (Right_Line[i]-Right_Line[i+2])<=-8&&
              (Right_Line[i]-Right_Line[i+3])<=-15&&
              (Right_Line[i]-Right_Line[i+4])<=-15)
        {
            Right_Up_Inflection_Point=i;//获取行数即可
        }
        if(Left_Up_Inflection_Point!=0&&Right_Up_Inflection_Point!=0)//下面两个找到就出去
        {
            break;
        }
    }
    if(abs(Right_Up_Inflection_Point-Left_Up_Inflection_Point)>=30)//纵向撕裂过大，视为误判
    {
        Right_Up_Inflection_Point=0;
        Left_Up_Inflection_Point=0;
    }
}

extern volatile int Island_State=0;           // 环岛状态
extern volatile int Ramp_Flag=0;              // 坡道标志
extern volatile int Cross_Flag=0;             // 十字标志

void Cross_Detect()
{
    int down_search_start=0;//下点搜索开始行
    Cross_Flag=0;
    if(Island_State==0&&Ramp_Flag==0)//与环岛互斥开
    {
        Left_Up_Inflection_Point=0;
        Right_Up_Inflection_Point=0;
        if(Both_Lost_Time>=15)//十字必定有双边丢线，在有双边丢线的情况下再开始找角点
        {
            Find_Up_Inflection_Point( MT9V03X_H-1, 0 );
            if(Left_Up_Inflection_Point==0&&Right_Up_Inflection_Point==0)//只要没有同时找到两个上点，直接结束
            {
                return;
            }
        }
        if(Left_Up_Inflection_Point!=0&&Right_Up_Inflection_Point!=0)       //找到两个上点，就找到十字了
        {
            Cross_Flag=1;//对应标志位，便于各元素互斥掉
            down_search_start=Left_Up_Inflection_Point>Right_Up_Inflection_Point?Left_Up_Inflection_Point:Right_Up_Inflection_Point;//用两个上拐点坐标靠下者作为下点的搜索上限
            Find_Down_Inflection_Point(MT9V03X_H-5,down_search_start+2);//在上拐点下2行作为下点的截止行
            if(Left_Down_Inflection_Point<=Left_Up_Inflection_Point)
            {
                Left_Down_Inflection_Point=0;//下点不可能比上点还靠上
            }
            if(Right_Down_Inflection_Point<=Right_Up_Inflection_Point)
            {
                Right_Down_Inflection_Point=0;//下点不可能比上点还靠上
            }
            if(Left_Down_Inflection_Point!=0&&Right_Down_Inflection_Point!=0)
            {//四个点都在，无脑连线，这种情况显然很少
                Left_Add_Line (Left_Line [Left_Up_Inflection_Point ],Left_Up_Inflection_Point ,Left_Line [Left_Down_Inflection_Point ] ,Left_Down_Inflection_Point);
                Right_Add_Line(Right_Line[Right_Up_Inflection_Point],Right_Up_Inflection_Point,Right_Line[Right_Down_Inflection_Point],Right_Down_Inflection_Point);
            }
            else if(Left_Down_Inflection_Point==0&&Right_Down_Inflection_Point!=0)//11//这里使用的都是斜率补线
            {//三个点                                                             //01
                Lengthen_Left_Boundry(Left_Up_Inflection_Point-1,MT9V03X_H-1);
                Right_Add_Line(Right_Line[Right_Up_Inflection_Point],Right_Up_Inflection_Point,Right_Line[Right_Down_Inflection_Point],Right_Down_Inflection_Point);
            }
            else if(Left_Down_Inflection_Point!=0&&Right_Down_Inflection_Point==0)//11
            {//三个点                                                             //10
                Left_Add_Line (Left_Line [Left_Up_Inflection_Point ],Left_Up_Inflection_Point ,Left_Line [Left_Down_Inflection_Point ] ,Left_Down_Inflection_Point);
                Lengthen_Right_Boundry(Right_Up_Inflection_Point-1,MT9V03X_H-1);
            }
            else if(Left_Down_Inflection_Point==0&&Right_Down_Inflection_Point==0)//11
            {//就俩上点                                                           //00
                Lengthen_Left_Boundry (Left_Up_Inflection_Point-1,MT9V03X_H-1);
                Lengthen_Right_Boundry(Right_Up_Inflection_Point-1,MT9V03X_H-1);
            }
        }
        else
        {
            Cross_Flag=0;
        }
    }
//    角点相关变量，debug使用
