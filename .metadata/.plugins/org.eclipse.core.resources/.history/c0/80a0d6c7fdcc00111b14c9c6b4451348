/*-------------------------------------------------------------------------------------------------------------------
  @brief     斑马线判定
  @param     null
  @return    null
  Sample     Zebra_Detect();
  @note      一个新想法，利用最长白列，每一列的最长白列可以看成从下往上的赛道边界，
                                           当看到斑马线时，会有较大的纵向撕裂，一条斑马线会有两次撕裂
-------------------------------------------------------------------------------------------------------------------*/
int Zebra_Flag=0;

// 帧计数器：每处理一帧加1，可以用来计时（50帧/秒，150帧约3秒）
uint16 zebra_run_frame = 0;

// 发车后多少帧内不判断斑马线：车停在起点斑马线前面发车，要留时间开过去
// 50帧约1秒，150帧约3秒，觉得不够就改大

void Zebra_Detect(void)
{
    int j=0;
    int count=0;
    static uint16 zebra_confirm=0;

    zebra_run_frame++;                  // 每处理一帧加1

    // 发车后前 ZEBRA_IGNORE_FRAMES 帧不认斑马线，免得把起点那条当成终点
    if(zebra_run_frame < 150)
        return;

    //元素互斥：环岛、十字、坡道时不做斑马线判断，避免中途误停车
    if(Cross_Flag!=0 || Island_State!=0 || Ramp_Flag!=0)
    {
        zebra_confirm=0;
        return;
    }

    //前面元素互斥各位自行补全
    if(Search_Stop_Line>=100)//视野很长
    {
        for(j=10;j<=MT9V03X_W-10;j++)
        {
            if(abs(White_Column[j]-White_Column[j+1])>=30)
            {
                count++;
            }
        }
    }
    if(count>=9)
    {
        zebra_confirm++;
    }
    else
    {
        zebra_confirm=0;
    }

    if(zebra_confirm>=5)
    {
        Zebra_Flag=1;                 //连续3帧满足再认斑马线，降低误判
    }
}
