/*-------------------------------------------------------------------------------------------------------------------
  @brief     普通大津求阈?
  @param     image       图像数组
             width       ?，宽?
             height      行，长度
  @return    threshold   返回int类型的的阈?
  Sample     threshold=my_adapt_threshold(mt9v03x_image[0],MT9V03X_W, MT9V03X_H);//普通大?
  @note      据说没有山威大津快，我感觉两个区别不?
-------------------------------------------------------------------------------------------------------------------*/

int My_Adapt_Threshold(uint8*image,uint16 width, uint16 height)   //大津算法，注意计算阈值的一定要是原图像
 {
     #define GrayScale 256      //宏定义灰?
     int pixelCount[GrayScale];     //定义像素次数
     float pixelPro[GrayScale];     //定义像素频率
     int i, j;
     int pixelSum = width * height/4;       //定义像素个数  隔一行，隔一?
     int  threshold = 0;                //定义阈?
     uint8* data = image;  //指向像素数据的指?
     for (i = 0; i < GrayScale; i++)        //像素次数、频率初始化
     {
         pixelCount[i] = 0;
         pixelPro[i] = 0;
     }
     uint32 gray_sum=0;     //定义灰度总和
     for (i = 0; i < height; i+=2)//统计灰度级中每个像素在整幅图像中的个?
     {
         for (j = 0; j <width; j+=2)
         {
             pixelCount[(int)data[i * width + j]]++;  //将当前的点的像素值作为计数数组的下标，强?int)防越?
             gray_sum+=(int)data[i * width + j];       //灰度值总和
         }
     }
     for (i = 0; i < GrayScale; i++) //计算每个像素值的点在整幅图像中的比例,相当于画直方图?
     {
         pixelPro[i] = (float)pixelCount[i] / pixelSum;
     }
     float w0, w1, u0tmp, u1tmp, u0, u1, u, deltaTmp, deltaMax = 0;
     w0 = w1 = u0tmp = u1tmp = u0 = u1 = u = deltaTmp = 0;
                     /*** w0          黑比?             当前分界线以下像素占整张图的比例
                          w1          白比?             当前分界线以上像素占整张图的比例
                          u0tmp       黑亮度贡?         黑所有亮度的比例加权和，还没有除?w0
                          u1tmp       白亮度贡?         白所有亮度的比例加权和，还没有除?w1
                          u0          黑平均亮?         黑像素的平均灰度?
                          u1          白平均亮?         白像素的平均灰度?
                          u           全图平均亮度        整张图片所有像素的平均灰度?
                          deltaTmp    当前分界线的得分    当前这个阈值把黑白分得有多开
                          deltaMax    目前最高得?       目前找到的最好的 deltaTmp                ***/
     for (j = 0; j < GrayScale; j++)//遍历灰度级[0,255]
     {
         w0 += pixelPro[j];  //背景部分每个灰度值的像素点所占比例之?  即背景部分的比例
         u0tmp += j * pixelPro[j];  //背景部分 每个灰度值的点的比例 *灰度?
         w1=1-w0;
         u1tmp=(float)gray_sum/pixelSum-u0tmp;
         u0 = u0tmp / w0;              //背景平均灰度
         u1 = u1tmp / w1;              //前景平均灰度
         u = u0tmp + u1tmp;            //全局平均灰度
         deltaTmp = w0 * pow((u0 - u), 2) + w1 * pow((u1 - u), 2);//平方
         if (deltaTmp > deltaMax)
         {
             deltaMax = deltaTmp;//最大类间方差法
             threshold = j;
         }
         if (deltaTmp < deltaMax)
         {
             break;
         }
     }
     if(threshold>255)
         threshold=255;
     if(threshold<0)
         threshold=0;
   return threshold;
 }

uint8 image_two_value[MT9V03X_H][MT9V03X_W];//二值化后的原数?
void Image_Binarization(int threshold)//图像二值化
{
    uint16 i,j;
    for(i=0;i<MT9V03X_H;i++)
    {
        for(j=0;j<MT9V03X_W;j++)//灰度图的数据只做判断，不进行更改，二值化图像放在了新数组?
        {
            if(mt9v03x_image[i][j]>threshold)
                image_two_value[i][j]=IMG_WHITE;//鐧?
            else
                image_two_value[i][j]=IMG_BLACK;//榛?
        }
    }
}

