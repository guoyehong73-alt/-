/*********************************************************************************************************************
* 函数名称：Menu_DrawMotor
* 功能说明：绘制电机PWM菜单
* 参数说明：无
* 返回说明：无
********************************************************************************************************************/
static void Menu_DrawMotor(void)
{
    // 清屏
    tft180_full(RGB565_BLACK);
    tft180_set_font(TFT180_8X16_FONT);

    // 标题
    tft180_set_color(RGB565_CYAN, RGB565_BLACK);
    tft180_show_string(0, 0, "MOTOR PWM");

