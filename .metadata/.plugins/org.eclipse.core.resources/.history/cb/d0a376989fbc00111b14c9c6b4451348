/*********************************************************************************************************************
* 函数名称：Menu_PD
* 功能说明：使用菜单中的P、D计算舵机PD输出
* 参数说明：err 中线误差
* 返回说明：舵机PWM
********************************************************************************************************************/
int Menu_PD(float err)
{
    // 上一次误差
    static float last_err = 0.0f;

    // 上一次输出
    static int last_out = SERVO_PWMMID;

    // 误差变化量
    float delta;

    // PD输出
    float out;

    // 从菜单返回图像页面后复位PD
    if(menu_pd_reset)
    {
        last_err = err;
        menu_pd_reset = 0;
    }

    // 误差基本不变时保持输出
    delta = err - last_err;
    if((delta > -0.01f) && (delta < 0.01f))
        return last_out;

    // 限制D项输入突变
    if(delta > MENU_D_LIMIT)
        delta = MENU_D_LIMIT;
    else if(delta < -MENU_D_LIMIT)
        delta = -MENU_D_LIMIT;

    // PD公式
    out = menu_kp * err + menu_kd * delta + SERVO_PWMMID;

    // 舵机上限
    if(out > SERVO_PWM_MAX)
        out = SERVO_PWM_MAX;

    // 舵机下限
    else if(out < SERVO_PWM_MIN)
        out = SERVO_PWM_MIN;

    // 保存本次误差和输出
    last_err = err;
    last_out = (int)out;

    return last_out;
}

/*********************************************************************************************************************
* 函数名称：Menu_GetMotorPwm
* 功能说明：返回电机基础PWM
* 参数说明：无
* 返回说明：左右电机基础PWM
********************************************************************************************************************/
int Menu_GetMotorPwm(void)
{
    return menu_motor_pwm;
}
