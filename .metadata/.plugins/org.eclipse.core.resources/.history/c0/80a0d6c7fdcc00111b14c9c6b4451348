void Lengthen_Left_Boundry(int start,int end)       //延长左边界
{
    int y,t;
    float k=0;
    if(start>=MT9V03X_H-1)//起始点位置校正，排除数组越界的可能
        start=MT9V03X_H-1;
    else if(start<=0)
        start=0;
    if(end>=MT9V03X_H-1)
        end=MT9V03X_H-1;
    else if(end<=0)
        end=0;
    if(end<start)//++访问，坐标互换
    {
        t=end;
        end=start;
        start=t;
    }

    if(start<=5)//因为需要在开始点向上5个点，对于起始点过于靠上，不能做延长，只能直接连
    {
         Left_Add_Line(Left_Line[start],start,Left_Line[end],end);
    }

    else
    {
        k=(float)(Left_Line[start]-Left_Line[start-4])/5.0;//这里的k?/斜率
        for(y=start;y<=end;y++)
        {
            Left_Line[y]=(int)(y-start)*k+Left_Line[start];//(x=(y-y1)*k+x1),点斜式变换
            if(Left_Line[y]>=MT9V03X_W-1)
            {
                Left_Line[y]=MT9V03X_W-1;
            }
            else if(Left_Line[y]<=0)
            {
                Left_Line[y]=0;
            }
            image_two_value[y][Left_Line[y]] = IMG_BLACK;
        }
    }
}

