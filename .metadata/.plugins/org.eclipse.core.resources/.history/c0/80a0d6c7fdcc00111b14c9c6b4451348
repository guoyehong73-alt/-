int Longest_White_Column_Left[2] = {0};
int Longest_White_Column_Right[2] = {0};
volatile int Search_Stop_Line = 0;
int Right_Lost_Flag[MT9V03X_H] = {0};
int Left_Lost_Flag[MT9V03X_H] = {0};
volatile int Left_Line[MT9V03X_H] = {0};
volatile int Right_Line[MT9V03X_H] = {0};
volatile int Left_Lost_Time = 0,Right_Lost_Time = 0,Both_Lost_Time = 0;
int left_border = 0, right_border = 0;//临时存储赛道位置
extern volatile int White_Column[MT9V03X_W] = {0};//每列白列长度
int Road_Wide[MT9V03X_H]={0};
int Center_Line[MT9V03X_H]={0};
int Boundry_Start_Left=0,Boundry_Start_Right=0;
void XunXian(void)
{

    uint8 start_column=20;      //起始?
    uint8 end_column=168;       //终止?
    int i,j;
    //复位
    Longest_White_Column_Left[0] = 0;
    Longest_White_Column_Left[1] = 0;
    Longest_White_Column_Right[0] = 0;
    Longest_White_Column_Right[1] = 0;

    Search_Stop_Line = 0;

    Left_Lost_Time = 0;
    Right_Lost_Time = 0;
    Both_Lost_Time = 0;

    Boundry_Start_Left = 0;
    Boundry_Start_Right = 0;

    for (i = 0; i < MT9V03X_H; i++)
    {
        Left_Lost_Flag[i] = 1;
        Right_Lost_Flag[i] = 1;

        Left_Line[i] = 0;
        Right_Line[i] = MT9V03X_W - 1;

        Road_Wide[i] = 0;
        Center_Line[i] = (MT9V03X_W - 1) / 2;
    }

    for (j = 0; j < MT9V03X_W; j++)
    {
        White_Column[j] = 0;
    }

    //环岛需要对最长白列范围进行限定，环岛3状态找不到上角点，可以修改下述参数
    //环岛3状态需要改变最长白列寻找范?
    if(Right_Island_Flag==1)//右环
    {
        if(Island_State==3)
        {
            start_column=40;
            end_column=MT9V03X_W-20;
        }
    }
    else if(Left_Island_Flag==1)//左环
    {
        if(Island_State==3)
        {
            start_column=20;
            end_column=MT9V03X_W-40;
        }
    }
//    else if(Left_Island_Flag==1)
//    {
//        if(Island_State==4)
//        {
//            start_column=0;
//            end_column=MT9V03X_W-60;
//        }
//    }
//    else if(Right_Island_Flag==1)
//    {
//        if(Island_State==4)
//        {
//            start_column=128;
//            end_column=MT9V03X_W;
//        }
//    }
    //从左到右，从下往上，遍历全图记录范围内的每一列白点数?
    for (j =start_column; j<=end_column; j++)
    {
        for (i = MT9V03X_H - 1; i >= 0; i--)
        {
            if(image_two_value[i][j] == IMG_BLACK)
                break;
            else
                White_Column[j]++;
        }
    }


    for(i=start_column;i<=end_column;i++)//从左到右找左边最长白?
    {
        if (Longest_White_Column_Left[0] < White_Column[i])//找最长的那一?
        {
            Longest_White_Column_Left[0] = White_Column[i];//?】是白列长度
            Longest_White_Column_Left[1] = i;              //?】是下标，第j?
        }
    }
        //从右到左找右左边最长白?
    for(i=end_column;i>=start_column;i--)//从右往左，注意条件，找到左边最长白列位置就可以停了
    {
        if (Longest_White_Column_Right[0] < White_Column[i])//找最长的那一?
        {
            Longest_White_Column_Right[0] = White_Column[i];//?】是白列长度
            Longest_White_Column_Right[1] = i;              //?】是下标，第j?
        }
    }
    Search_Stop_Line = Longest_White_Column_Left[0];//搜索截止行选取左或者右区别不大，他们两个理论上是一样的

    if (Island_State == 3)
    {
        int target_column = 45;                             //左环固定取第50列
        if(Right_Island_Flag==1)
        {
            target_column = MT9V03X_W - 1 - 45;             //右环取左环镜像列
        }
        Longest_White_Column_Right[0] = Longest_White_Column_Left[0] = White_Column[target_column];
        Longest_White_Column_Left[1]  = target_column;
        Longest_White_Column_Right[1] = target_column;
        Search_Stop_Line = White_Column[target_column];
    }

/*********************************************************由最长白线推出左右边?*************************************************/


     for (i = MT9V03X_H - 1; i >=MT9V03X_H-Search_Stop_Line; i--)//常规巡线
     {//从最下面一行，访问到我的有效视野行
         left_border = 0;
         right_border = MT9V03X_W - 1;
         for (j = Longest_White_Column_Right[1]; j <= MT9V03X_W - 1 - 2; j++)
         {
             if (image_two_value[i][j] ==IMG_WHITE && image_two_value[i][j + 1] == IMG_BLACK && image_two_value[i][j + 2] == IMG_BLACK)//白黑黑，找到右边?
             {
                 right_border = j;
                 Right_Lost_Flag[i] = 0; //右丢线数组，丢线?，不丢线?
                 break;
             }
             else if(j>=MT9V03X_W-1-2)//没找到右边界，把屏幕最右赋值给右边?
             {
                 right_border = j;
                 Right_Lost_Flag[i] = 1; //右丢线数组，丢线?，不丢线?
                 break;
             }
         }
         for (j = Longest_White_Column_Left[1]; j >= 0 + 2; j--)//往左边扫描
         {//从最下面一行，访问到我的有效视野行
             if (image_two_value[i][j] ==IMG_WHITE && image_two_value[i][j - 1] == IMG_BLACK && image_two_value[i][j - 2] == IMG_BLACK)//黑黑白认为到达左边界
             {
                 left_border = j;
                 Left_Lost_Flag[i] = 0; //左丢线数组，丢线?，不丢线?
                 break;
             }
             else if(j<=0+2)
             {
                 left_border = j;//找到头都没找到边，就把屏幕最左右当做边界
                 Left_Lost_Flag[i] = 1; //左丢线数组，丢线?，不丢线?
                 break;
             }
         }
         Left_Line [i] = left_border;       //左边线线数组
         Right_Line[i] = right_border;      //右边线线数组
     }
     for (i = MT9V03X_H - 1; i >= 0; i--)//赛道数据初步分析
         {
             if (Left_Lost_Flag[i]  == 1)   //左边丢线?
                 Left_Lost_Time++;
             if (Right_Lost_Flag[i] == 1)   //右边丢线?
                 Right_Lost_Time++;
             if (Left_Lost_Flag[i] == 1 && Right_Lost_Flag[i] == 1)  //双边丢线?
                 Both_Lost_Time++;
             if (Boundry_Start_Left ==  0 && Left_Lost_Flag[i]  != 1)//记录第一个非丢线点，边界起始?
                 Boundry_Start_Left = i;
             if (Boundry_Start_Right == 0 && Right_Lost_Flag[i] != 1)
                 Boundry_Start_Right = i;
             Road_Wide[i]=Right_Line[i]-Left_Line[i];
             Center_Line[i] = (Left_Line[i] + Right_Line[i]) / 2;

         }
     //tft180_draw_line(Center_Line[0], 0, Center_Line[MT9V03X_H-1], MT9V03X_H,RGB565_RED);

     //debug使用，屏幕显示相关参?
  //    tft180_show_char(0,0, Longest_White_Column_Right[0]);       //?】是白列长度
  //    tft180_show_char(0,1, Longest_White_Column_Right[1]);       //?】是下标，第j?
  //    tft180_show_char(0,2, Longest_White_Column_Left[0]);        //?】是白列长度
  //    tft180_show_char(0,3, Longest_White_Column_Left[1]);        //?】是下标，第j?

}

/*-------------------------------------------------------------------------------------------------------------------
  @brief     直道检?
  @param     null
  @return    null
  Sample     Straight_Detect();
  @note      利用最长白列，边界起始点，中线起始点，
-------------------------------------------------------------------------------------------------------------------*/
extern volatile uint8 Straight_Flag=0;
extern volatile float Err=0;
void Straight_Detect(void)
{
    Straight_Flag=0;
    Err=Err_Sum();
    if(Search_Stop_Line>=110)//截止行很大，很远
    {
        if(Boundry_Start_Left>=105&&Boundry_Start_Right>=105)//起始点靠下
        {
            if(-5<=Err&&Err<=5)//误差很小
            {
                Straight_Flag=1;//认为是直?
            }
        }
    }
}

/*-------------------------------------------------------------------------------------------------------------------
  @brief  查找十字下方两个拐点（靠近车头一侧的路口角）
  @param  start 搜索起始行（靠下，数值大），end 搜索终止行（靠上，数值小?
  @return 无，直接修改全局 Left_Down_Find / Right_Down_Find
  @note   特征：拐点下方（近处）边线平稳，拐点上方（远处）边线突变
-------------------------------------------------------------------------------------------------------------------*/
extern int Right_Down_Inflection_Point=0;
extern int Left_Down_Inflection_Point=0;
void Find_Down_Inflection_Point(int start, int end)
{
    int i, t;
    Right_Down_Inflection_Point = 0;
    Left_Down_Inflection_Point = 0;

    // 行号矫正：保证从下往上搜（start > end?
    if(start < end) {
        t = start;
        start = end;
        end = t;
    }

    // 数组越界保护：底?行数据不稳定，舍?
    if(start >= MT9V03X_H - 1 - 5)
        start = MT9V03X_H - 1 - 5;
    // 搜索截止行以上的区域不搜?
    if(end <= MT9V03X_H - Search_Stop_Line)
        end = MT9V03X_H - Search_Stop_Line;
    if(end <= 5) end = 5;

    // 从下往上逐行扫描
    for(i = start; i >= end; i--)
    {
        // 左下拐点：下方连?行平稳，上方向左突变（x骤减?
        if(Left_Down_Inflection_Point == 0 &&
           abs(Left_Line[i] - Left_Line[i+1]) <= 5 &&   // 下方?行平?
           abs(Left_Line[i+1] - Left_Line[i+2]) <= 5 && // 下方?行平?
           abs(Left_Line[i+2] - Left_Line[i+3]) <= 5 && // 下方?行平?
           (Left_Line[i] - Left_Line[i-2]) >= 10 &&      // 上方2行处x突变（变小）
           (Left_Line[i] - Left_Line[i-3]) >= 16 &&     // 上方3行处突变更明?
           (Left_Line[i] - Left_Line[i-4]) >= 21)       // 上方4行处确认突变
        {
            Left_Down_Inflection_Point = i;
        }

        // 右下拐点：下方连?行平稳，上方向右突变（x骤增?
        if(Right_Down_Inflection_Point == 0 &&
           abs(Right_Line[i] - Right_Line[i+1]) <= 5 &&
           abs(Right_Line[i+1] - Right_Line[i+2]) <= 5 &&
           abs(Right_Line[i+2] - Right_Line[i+3]) <= 5 &&
           (Right_Line[i] - Right_Line[i-2]) <= -10 &&
           (Right_Line[i] - Right_Line[i-3]) <= -16 &&
           (Right_Line[i] - Right_Line[i-4]) <= -21)
        {
            Right_Down_Inflection_Point = i;
        }

        // 两个都找到就提前退出，节省时间
        if(Left_Down_Inflection_Point != 0 && Right_Down_Inflection_Point != 0)
            break;
    }
}
/*-------------------------------------------------------------------------------------------------------------------
  @brief  查找十字上方两个拐点（远离车头一侧的路口角）
  @param  start 搜索起始行（靠下，数值大），end 搜索终止行（靠上，数值小?
  @return 无，修改全局 Left_Up_Inflection_Find / Right_Up_Inflection_Find
  @note   特征：拐点上方（远处）边线平稳，拐点下方（近处）边线突变
-------------------------------------------------------------------------------------------------------------------*/

extern int Left_Up_Inflection_Point = 0;           // 左上拐点所在行号，0=未找?
extern int Right_Up_Inflection_Point = 0;          // 右上拐点所在行号，0=未找?
void Find_Up_Inflection_Point(int start,int end)
{
    int i,t;
    Left_Up_Inflection_Point=0;
    Right_Up_Inflection_Point=0;
    if(start<end)
    {
        t=start;
        start=end;
        end=t;
    }
    if(end<=MT9V03X_H-Search_Stop_Line)
        end=MT9V03X_H-Search_Stop_Line;
    if(end<=5)//及时最长白列非常长，也要舍弃部分点，防止数组越?
        end=5;
    if(start>=MT9V03X_H-1-5)//下面5行数据不稳定，不能作为边界点来判断，舍弃
        start=MT9V03X_H-1-5;
    for(i=start;i>=end;i--)
    {
        if(Left_Up_Inflection_Point==0&&//只找第一个符合条件的?
           abs(Left_Line[i]-Left_Line[i-1])<=5&&
           abs(Left_Line[i-1]-Left_Line[i-2])<=5&&
           abs(Left_Line[i-2]-Left_Line[i-3])<=5&&
              (Left_Line[i]-Left_Line[i+2])>=10&&
              (Left_Line[i]-Left_Line[i+3])>=15&&
              (Left_Line[i]-Left_Line[i+4])>=20)
        {
            Left_Up_Inflection_Point=i;//获取行数即可
        }
        if(Right_Up_Inflection_Point==0&&//只找第一个符合条件的?
           abs(Right_Line[i]-Right_Line[i-1])<=5&&//下面两行位置差不?
           abs(Right_Line[i-1]-Right_Line[i-2])<=5&&
           abs(Right_Line[i-2]-Right_Line[i-3])<=5&&
              (Right_Line[i]-Right_Line[i+2])<=-10&&
              (Right_Line[i]-Right_Line[i+3])<=-15&&
              (Right_Line[i]-Right_Line[i+4])<=-20)
        {
            Right_Up_Inflection_Point=i;//获取行数即可
        }
        if(Left_Up_Inflection_Point!=0&&Right_Up_Inflection_Point!=0)//下面两个找到就出?
        {
            break;
        }
    }
    if(abs(Right_Up_Inflection_Point-Left_Up_Inflection_Point)>=30)//纵向撕裂过大，视为误?
    {
        Right_Up_Inflection_Point=0;
        Left_Up_Inflection_Point=0;
    }
}

/*-------------------------------------------------------------------------------------------------------------------
  @brief     右下角点检?
  @param     起始点，终止?
  @return    返回角点所在的行数，找不到返回0
  Sample     Find_Right_Down_Point(int start,int end);
  @note      角点检测阈值可根据实际值更?
-------------------------------------------------------------------------------------------------------------------*/
int Find_Right_Down_Inflection_Point(int start,int end)//找四个角点，返回值是角点所在的行数
{
    int i,t;
    int right_down_line=0;
    if(Right_Lost_Time>=0.92*MT9V03X_H)//大部分都丢线，没有拐点判断的意义
        return right_down_line;
    if(start<end)
    {
        t=start;
        start=end;
        end=t;
    }
    if(start>=MT9V03X_H-1-5)//下面5行数据不稳定，不能作为边界点来判断，舍弃
        start=MT9V03X_H-1-5;
    if(end<=MT9V03X_H-Search_Stop_Line)
        end=MT9V03X_H-Search_Stop_Line;
    if(end<=5)
       end=5;
    for(i=start;i>=end;i--)
    {
        if(right_down_line==0&&//只找第一个符合条件的?
           abs(Right_Line[i]-Right_Line[i+1])<=5&&//角点的阈值可以更?
           abs(Right_Line[i+1]-Right_Line[i+2])<=5&&
           abs(Right_Line[i+2]-Right_Line[i+3])<=5&&
              (Right_Line[i]-Right_Line[i-2])<=-10&&
              (Right_Line[i]-Right_Line[i-3])<=-15&&
              (Right_Line[i]-Right_Line[i-4])<=-20)
        {
            right_down_line=i;//获取行数即可
            break;
        }
    }
    return right_down_line;
}

/*-------------------------------------------------------------------------------------------------------------------
  @brief     左下角点检?
