/*********************************************************************************************************************
* 文件名称：menu.c
* 功能说明：单页参数菜单
* 页面内容：P、D、电机PWM
* 保存说明：不写Flash，掉电后恢复默认值
* 按键说明：
*           S1 = P32_4：切换当前参数
*           S2 = P22_0：减小当前参数
*           S3 = P23_1：增大当前参数
*           S4 = P22_2：图像页面和参数页面切换
********************************************************************************************************************/

#include "menu.h"
#include "control.h"

// P参数最小值
#define MENU_KP_MIN              (0.0f)

// P参数最大值
#define MENU_KP_MAX              (3.0f)

// P参数调整步长
#define MENU_KP_STEP             (0.05f)

// D参数最小值
#define MENU_KD_MIN              (0.0f)

// D参数最大值
#define MENU_KD_MAX              (4.0f)

// D参数调整步长
#define MENU_KD_STEP             (0.05f)

// 电机PWM最小值
#define MENU_MOTOR_MIN           (0)

// 电机PWM最大值
#define MENU_MOTOR_MAX           (4000)

// 电机PWM调整步长
#define MENU_MOTOR_STEP          (100)

// 当前选中的参数编号
typedef enum
{
    // 当前选中P
    MENU_ITEM_P = 0,

    // 当前选中D
    MENU_ITEM_D,

    // 当前选中电机PWM
    MENU_ITEM_MOTOR,

    // 参数总数
    MENU_ITEM_COUNT,
} menu_item_enum;

// 当前P参数
static volatile float menu_kp = 1.69f;

// 当前D参数
static volatile float menu_kd = 2.99f;

// 当前电机基础PWM
volatile int menu_motor_pwm = 2100;

// 当前选中的参数
static uint8 menu_item = MENU_ITEM_P;

// 1表示菜单页面，0表示图像页面
uint8 menu_page = 0;

// 1表示需要重绘菜单
static uint8 menu_dirty = 1;

/*********************************************************************************************************************
* 函数名称：Menu_KeyEvent
* 功能说明：读取按键事件
* 参数说明：key 按键编号
* 返回说明：1表示有按键事件，0表示无按键事件
********************************************************************************************************************/
static uint8 Menu_KeyEvent(key_index_enum key)
{
    // 按键当前状态
    key_state_enum state = key_get_state(key);

    // 短按或长按都作为有效事件
    if((state == KEY_SHORT_PRESS) || (state == KEY_LONG_PRESS))
    {
        // 清除按键状态
        key_clear_state(key);
        return 1;
    }

    return 0;
}

/*********************************************************************************************************************
* 函数名称：Menu_Adjust
* 功能说明：调整当前选中的参数
* 参数说明：direction 1表示增大，-1表示减小
* 返回说明：无
********************************************************************************************************************/
static void Menu_Adjust(int direction)
{
    // 调整P
    if(menu_item == MENU_ITEM_P)
    {
        menu_kp += direction * MENU_KP_STEP;

        if(menu_kp < MENU_KP_MIN)
            menu_kp = MENU_KP_MIN;
        if(menu_kp > MENU_KP_MAX)
            menu_kp = MENU_KP_MAX;
    }
    // 调整D
    else if(menu_item == MENU_ITEM_D)
    {
        menu_kd += direction * MENU_KD_STEP;

        if(menu_kd < MENU_KD_MIN)
            menu_kd = MENU_KD_MIN;
        if(menu_kd > MENU_KD_MAX)
            menu_kd = MENU_KD_MAX;
    }
    // 调整电机PWM
    else
    {
        menu_motor_pwm += direction * MENU_MOTOR_STEP;

        if(menu_motor_pwm < MENU_MOTOR_MIN)
            menu_motor_pwm = MENU_MOTOR_MIN;
        if(menu_motor_pwm > MENU_MOTOR_MAX)
            menu_motor_pwm = MENU_MOTOR_MAX;
    }

    // 参数变化后需要重绘
    menu_dirty = 1;
}

/*********************************************************************************************************************
* 函数名称：Menu_Draw
* 功能说明：绘制单页参数菜单
* 参数说明：无
* 返回说明：无
********************************************************************************************************************/
static void Menu_Draw(void)
{
    // 清屏
    tft180_full(RGB565_BLACK);

    // 8x16字体显示参数
    tft180_set_font(TFT180_8X16_FONT);
    tft180_set_color(RGB565_CYAN, RGB565_BLACK);
    tft180_show_string(0, 0, "PARAM SET");

    // 显示P
    tft180_set_color((menu_item == MENU_ITEM_P) ? RGB565_YELLOW : RGB565_WHITE,
                     RGB565_BLACK);
    tft180_show_string(0, 28, "P:");
    tft180_show_float(32, 28, menu_kp, 4, 2);

    // 显示D
    tft180_set_color((menu_item == MENU_ITEM_D) ? RGB565_YELLOW : RGB565_WHITE,
                     RGB565_BLACK);
    tft180_show_string(0, 52, "D:");
    tft180_show_float(32, 52, menu_kd, 4, 2);

    // 显示电机PWM
    tft180_set_color((menu_item == MENU_ITEM_MOTOR) ? RGB565_YELLOW : RGB565_WHITE,
                     RGB565_BLACK);
    tft180_show_string(0, 76, "PWM:");
    tft180_show_int(40, 76, menu_motor_pwm, 4);

    // 按键提示
    tft180_set_font(TFT180_6X8_FONT);
    tft180_set_color(RGB565_WHITE, RGB565_BLACK);
    tft180_show_string(0, 104, "S1:NEXT S2- S3+");
    tft180_show_string(0, 116, "S4:IMAGE");
}

/*********************************************************************************************************************
* 函数名称：Menu_Init
* 功能说明：初始化菜单
* 参数说明：无
* 返回说明：无
********************************************************************************************************************/
void Menu_Init(void)
{
    // 初始化按键，10表示扫描周期约10ms
    key_init(10);

    // 清除按键状态
    key_clear_all_state();

    // 默认显示图像页面
    menu_page = 0;
    menu_dirty = 1;
    menu_item = MENU_ITEM_P;

    // 默认字体和颜色
    tft180_set_font(TFT180_8X16_FONT);
    tft180_set_color(RGB565_WHITE, RGB565_BLACK);
}

/*********************************************************************************************************************
* 函数名称：Menu_Update
* 功能说明：扫描按键并处理菜单
* 参数说明：无
* 返回说明：无
********************************************************************************************************************/
void Menu_Update(void)
{
    // 扫描按键
    key_scanner();

    // 图像页面：S4进入菜单
    if(menu_page == 0)
    {
        if(Menu_KeyEvent(KEY_4))
        {
            menu_page = 1;
            menu_dirty = 1;
        }
    }
    // 菜单页面
    else
    {
        // S1切换当前参数
        if(Menu_KeyEvent(KEY_1))
        {
            menu_item++;
            if(menu_item >= MENU_ITEM_COUNT)
                menu_item = MENU_ITEM_P;

            menu_dirty = 1;
        }

        // S2减小
        if(Menu_KeyEvent(KEY_2))
            Menu_Adjust(-1);

        // S3增大
        if(Menu_KeyEvent(KEY_3))
            Menu_Adjust(1);

        // S4返回图像
        if(Menu_KeyEvent(KEY_4))
        {
            menu_page = 0;
            menu_dirty = 1;
        }
    }

    // 菜单页面需要重绘时绘制
    if((menu_page != 0) && menu_dirty)
    {
        menu_dirty = 0;
        Menu_Draw();
    }

    // 菜单页面按约10ms扫描按键
    if(menu_page != 0)
        system_delay_ms(10);
}

/*********************************************************************************************************************
* 函数名称：Menu_DrawImageDown
* 功能说明：在图像页面底部显示参数
